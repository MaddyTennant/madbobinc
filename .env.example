# Postgres connection string (docker-compose provides a matching local instance)
DATABASE_URL="postgresql://madbob:madbob@localhost:5432/madbob_spend?schema=public"

# Anthropic API key used by both the LLM oversight engine and the NL query console.
# If unset, both features fall back to a deterministic mock generator so the app
# remains fully demoable offline.
ANTHROPIC_API_KEY=""

# Model overrides (defaults shown). See README for rationale.
OVERSIGHT_MODEL="claude-opus-5"
QUERY_MODEL="claude-sonnet-5"

# 32-byte (64 hex char) key used for AES-256-GCM encryption of connector
# credentials and other secrets at rest. Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=""

# Secret used to sign session and embed-widget JWTs. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=""

# Set to "true" to switch the whole app into Tech-only mode for a client demo
# (Salto CloudWorks): no vertical selector anywhere, every workspace is Tech,
# and Settings > Workspace locks the vertical to Tech. Off (default/unset)
# shows the original Hospitality / Healthcare / Tech selector, unrestricted.
# See README-tech.md.
ENABLE_TECH_VERTICAL="false"
